    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"cuil\": \"20123456789\",\n  \"legajo\": \"L-001\",\n  \"area\": \"Inspecciones\",\n  \"email\": \"juan.perez@siglu.com\",\n  \"password\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el id que devolvió la API para usarlo en los pedidos siguientes",
                  "const datos = pm.response.json();",
                  "if (datos.id) pm.collectionVariables.set('userId', datos.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.perez@siglu.com\",\n  \"password\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el id que devolvió la API para usarlo en los pedidos siguientes",
                  "const datos = pm.response.json();",
                  "if (datos.access_token) pm.collectionVariables.set('token', datos.access_token);",
                  "if (datos.user && datos.user.id) pm.collectionVariables.set('userId', datos.user && datos.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
